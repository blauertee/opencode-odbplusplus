{
  "name": "opencode-odbplusplus",
  "version": "0.1.0",
  "description": "OpenCode plugin: inspect PCB designs (ODB++) via tool calls, parsed in-process with OdbDesign",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "native/odbpp.cpp",
    "native/CMakeLists.txt",
