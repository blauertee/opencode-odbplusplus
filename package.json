    "native/patches"
  ],
  "scripts": {
    "build:native": "bash native/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "testdata": "bash scripts/export-test-design.sh"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
